license: "Apache-2.0 OR MIT"
repository-code: "https://github.com/sebastienrousseau/iso20022-evidence-pack-mcp"
url: "https://sebastienrousseau.github.io/iso20022-evidence-pack-mcp/"
keywords:
  - ISO 20022
  - audit evidence
  - compliance
  - Ed25519
  - Model Context Protocol
  - MCP
  - AI agents
  - payments
